# Copia este archivo como .env.local para desarrollo (no se commitea).
# En producción estos valores van como secrets de GitHub Actions.

# Tokens de acceso al editor (separados por coma)
VITE_VALID_TOKENS=dev-token

# EmailJS — envío de datos de la boda
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Subida de fotos — endpoint upload.php en Hostinger (ver hostinger/README.md)
VITE_UPLOAD_ENDPOINT=https://TUDOMINIO.com/wedya-uploads/upload.php
VITE_UPLOAD_KEY=

# API del engine (Cloudflare Worker) — panel admin para guardar/leer bodas
VITE_WEDDINGS_API=https://admin.mywedya.com

# Analytics — mismo GA4/Pixel que wedya.com (el editor es parte del mismo
# embudo: marketing → editor → cliente). Quedan inactivos si se dejan vacíos.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
 