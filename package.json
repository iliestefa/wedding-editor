    "worker:deploy": "npm run build:viewer && cd worker && npx wrangler deploy"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@iliestefa/wedding-elegant": "file:../elegante",
    "@iliestefa/wedding-soho": "file:../soho",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.97.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
